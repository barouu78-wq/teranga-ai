# Required in production
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-5.6-luna
SECRET_KEY=
TRUST_PROXY=true
# Redis enables shared rate limiting and abuse protection across instances.
REDIS_URL=
