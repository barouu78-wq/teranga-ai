# Obligatoire
OPENAI_API_KEY=

# Production : active la vérification de SECRET_KEY et la liste des hôtes autorisés
TERANGA_ENV=production
# Au moins 32 caractères aléatoires (ex. : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Hôtes acceptés en production (séparés par des virgules)
TRUSTED_HOSTS=teranga-ai.fr,www.teranga-ai.fr,127.0.0.1,localhost
ALLOWED_ORIGINS=https://teranga-ai.fr,https://www.teranga-ai.fr
SITE_URL=https://teranga-ai.fr

# Optionnel
OPENAI_MODEL=gpt-5.6-luna
TRUST_PROXY=true
# Redis partage la limitation de débit et le score d'abus entre workers/instances.
REDIS_URL=
# Google Custom Search (source principale des images de l'Explorer)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Quotas optionnels (par minute / par heure et par client)
TRIP_RATE_LIMIT=4
TRIP_HOURLY_LIMIT=20
PRACTICAL_RATE_LIMIT=8
PRACTICAL_HOURLY_LIMIT=40
EXPLORER_IMAGE_RATE_LIMIT=60
EXPLORER_IMAGE_HOURLY_LIMIT=400
